# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Free tier depends on model and account; check AI Studio for your quota.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MAX_OUTPUT_TOKENS=6000
GEMINI_OUTPUT_LIMIT=16000
# Enable optional tools ONLY if your account and model allow them.
# Google Search grounding may require paid billing on newer Gemini models.
GEMINI_ENABLE_SEARCH=0
GEMINI_ENABLE_CODE_EXECUTION=0
GEMINI_ENABLE_IMAGES=0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Optional thinking level, only on models that support it; otherwise leave blank.
GEMINI_THINKING_LEVEL=
# Disabled by default: requires Docker and manually downloaded python:3.12-slim image
ENABLE_DOCKER_TESTS=0
# For HTTPS deployments only; localhost should keep 0.
COOKIE_SECURE=0
# Optional preloaded local-only Docker test images, with dependency sets included.
HITMAN_PYTHON_TEST_IMAGE=python:3.12-slim
HITMAN_NODE_TEST_IMAGE=node:22-alpine

# Never enable this for a public server; creates first admin locally only.
ALLOW_FIRST_ADMIN_SETUP=0

# Public chat-only demo. In demo mode visitors open / without login.
# Private account and workspace routes are blocked. Guest attachments are transient.
# Guest project ZIPs require explicit HITMAN_PUBLIC_PROJECTS=1.
# Set to 1 ONLY when you want anonymous visitor chat. Use quotas and monitor costs.
HITMAN_PUBLIC_DEMO=1
# Public guest project ZIP builder: disabled by default to protect free-tier quota.
HITMAN_PUBLIC_PROJECTS=0

# Public user accounts and password recovery (unused when public demo = 1)
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
EMAIL_TRANSPORT=console
# For public hosting: APP_ENV=production, EMAIL_TRANSPORT=smtp, COOKIE_SECURE=1,
# PUBLIC_BASE_URL=https://your-domain.example and real SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional, never enabled by default: containers may download dependencies in an isolated build step
ENABLE_DEP_INSTALL=0
# Per-response output budget. Actual API pricing and access depend on your account.

# HITMAN AI v7 optional advanced tools — ALL OFF for public Render Free by default.
# Enabling them may require paid API usage, a compatible model and abuse controls.
HITMAN_PUBLIC_RESEARCH=0
HITMAN_PUBLIC_IMAGE=0
HITMAN_PUBLIC_REPAIR=0
HITMAN_PUBLIC_LIVE_VOICE=0
# Live voice needs: pip install -r requirements-voice.txt
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Optional separately billed OpenAI API text model (NOT ChatGPT Pro subscription access).
HITMAN_TEXT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_REASONING_MODEL=gpt-4.1

# HITMAN AI v8 Builder Studio: public demo static ZIP scan always available.
# Set to 1 locally to use Gemini-powered project creation / AI code review.
# Leave 0 on a public Render Free service until authentication, monitoring,
# shared rate limits and quotas are in place.
HITMAN_PUBLIC_STUDIO_BUILD=0
HITMAN_PUBLIC_STUDIO_REVIEW=0

# HITMAN AI v9: LOCAL-ONLY Docker test + bounded Gemini auto-repair agent.
# NEVER enable on Render, another public server, or a shared workstation.
# Must run with APP_ENV=development and browser at http://127.0.0.1:8000.
HITMAN_LOCAL_DOCKER_AGENT=0
# Pre-pull Docker images before executing a project. No network access during tests.
HITMAN_AGENT_PYTHON_IMAGE=python:3.12-slim
HITMAN_AGENT_NODE_IMAGE=node:22-alpine
# Optional: build tools/Dockerfile.python-agent and set the Python image to
# hitman-agent-python:local for pytest / selected ML dependencies.

# HITMAN AI v10 Pro Review (premium-style TWO-PASS ANSWER REFINEMENT).
# Set 1 locally to use. This uses ~2 model calls per answer and does not
# unlock any ChatGPT Pro subscription features. Not suitable for anonymous
# public Render without authentication and provider quota controls.
HITMAN_PRO_REVIEW=0
# Additional explicit production override. KEEP 0 on public Render Free.
HITMAN_PRO_PUBLIC=0
# Only use 1 if GEMINI_ENABLE_SEARCH=1 and your model supports grounding.
HITMAN_PRO_GROUNDING=0
# Guest chat maximum answer tokens, bounded to 1200..8000 by backend.
# Higher values can increase API cost and latency.
HITMAN_CHAT_MAX_OUTPUT_TOKENS=3500

# HITMAN AI v11: current-info questions can automatically use real Gemini Search grounding.
# Research requires API/model grounding entitlement and may cost money.
# Turn on both flags locally to handle requests such as "today cricket updates"
# and follow-ups like "give updates" without relying on stale model knowledge.
HITMAN_AUTO_WEB_SEARCH=0
# Local development can analyze PDFs/images up to 4 MB. Public Render remains 1.2 MB.
HITMAN_LOCAL_ATTACHMENT_BYTES=4000000
# Local-only ZIP context inspection up to 2 MB; production stays at 250 KB.
HITMAN_LOCAL_ZIP_BYTES=2000000

# HITMAN AI v12 — optional real-source research. See V12_START_HERE.md.
# RUN `python enable_research.py` in the local project to explicitly opt in.
# Search calls may use billed Gemini or Brave API quota; no provider guarantees live data.
# Tavily provides current web search snippets; obtain a key at https://app.tavily.com
# For local Tavily research: fill TAVILY_API_KEY, then run python enable_tavily.py.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Local-only personal/noncommercial weather. Public/commercial use needs a licence.
HITMAN_ENABLE_WEATHER=0
HITMAN_WEATHER_PUBLIC=0
HITMAN_DEFAULT_WEATHER_CITY=Chennai, India
