# Build once on your LOCAL machine. Only known packages are installed here;
# uploaded source-code ZIPs are never copied into this image at build time.
# This image is for small example projects, not arbitrary project dependencies.
FROM python:3.12-slim
RUN python -m pip install --no-cache-dir \
    'pytest>=8,<10' \
    'fastapi>=0.115,<1' \
    'httpx>=0.27,<1' \
    'numpy>=2,<3' \
    'pandas>=2.2,<3' \
    'scikit-learn>=1.6,<2'
USER 65534:65534
